.admin-marketplace-page {
  min-height: 100vh;
  padding: 28px;
  background:
    radial-gradient(circle at 20% 0%, rgba(255,255,255,.07), transparent 30%),
    linear-gradient(135deg,#050505,#0b0b0d 45%,#111114);
  color:#fff;
}

.admin-marketplace-header {
  display:flex;
  justify-content:space-between;
  align-items:flex-end;
  gap:20px;
  margin-bottom:24px;
}

.admin-marketplace-kicker {
  color:#aaa;
  font-size:11px;
  font-weight:900;
  letter-spacing:3px;
}

.admin-marketplace-header h1 {
  margin:5px 0;
  font-size:34px;
  font-weight:950;
}

.admin-marketplace-header p {
  margin:0;
  color:#999;
}

.marketplace-total {
  min-width:100px;
  padding:16px;
  border:1px solid #29292d;
  border-radius:14px;
  background:#101012;
  text-align:center;
}

.marketplace-total strong {
  display:block;
  font-size:28px;
}

.marketplace-total span {
  color:#888;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:1px;
}

.marketplace-message {
  padding:14px 16px;
  border-radius:12px;
  margin-bottom:18px;
  font-weight:800;
}

.marketplace-message.success {
  background:rgba(30,150,80,.15);
  border:1px solid rgba(70,220,130,.3);
  color:#8ff0b4;
}

.marketplace-message.error {
  background:rgba(200,40,40,.15);
  border:1px solid rgba(255,80,80,.35);
  color:#ff9b9b;
}

.marketplace-builder,
.marketplace-catalogue {
  border:1px solid #27272c;
  border-radius:18px;
  background:rgba(12,12,15,.9);
  overflow:hidden;
}

.marketplace-step {
  padding:24px;
  border-bottom:1px solid #242429;
}

.step-heading {
  display:flex;
  align-items:center;
  gap:14px;
  margin-bottom:25px;
}

.step-heading > span {
  width:38px;
  height:38px;
  display:grid;
  place-items:center;
  border-radius:10px;
  background:#fff;
  color:#000;
  font-weight:950;
}

.step-heading strong {
  display:block;
  font-size:18px;
}

.step-heading small {
  color:#777;
}

.picker-group {
  margin-top:28px;
}

.picker-group h3 {
  margin-bottom:14px;
  font-size:14px;
  letter-spacing:.5px;
}

.visual-options {
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:10px;
}

.visual-option {
  min-height:105px;
  padding:10px;
  border:1px solid #29292e;
  border-radius:12px;
  background:linear-gradient(145deg,#111115,#18181d);
  color:#fff;
  cursor:pointer;
  transition:.18s ease;
  text-align:center;
}

.visual-option:hover {
  transform:translateY(-2px);
  border-color:#777;
  background:#1d1d22;
}

.visual-option.selected {
  border-color:#fff;
  box-shadow:0 0 0 2px rgba(255,255,255,.12),0 8px 30px rgba(255,255,255,.08);
}

.visual-option strong {
  display:block;
  font-size:11px;
  margin-top:7px;
}

.visual-option small {
  display:block;
  margin-top:3px;
  color:#777;
  font-size:9px;
}

.option-preview {
  min-height:43px;
  display:grid;
  place-items:center;
  border-radius:8px;
  background:#08080a;
  border:1px solid #27272b;
  font-weight:950;
  font-size:17px;
  overflow:hidden;
}

.font-bold .option-preview,
.preview-username.font-bold {
  font-weight:950;
}

.font-elite .option-preview,
.preview-username.font-elite {
  font-weight:950;
  letter-spacing:2px;
  text-transform:uppercase;
}

.font-neon .option-preview,
.preview-username.font-neon {
  color:#fff;
  text-shadow:0 0 8px #fff,0 0 20px #9ff;
}

.font-royal .option-preview,
.preview-username.font-royal {
  font-family:Georgia,serif;
  font-weight:900;
  letter-spacing:1px;
}

.font-cyber .option-preview,
.preview-username.font-cyber {
  letter-spacing:3px;
  text-transform:uppercase;
}

.font-titan .option-preview,
.preview-username.font-titan {
  font-weight:1000;
  transform:scaleX(1.05);
}

.font-warrior .option-preview,
.preview-username.font-warrior {
  font-weight:900;
  letter-spacing:1px;
}

.font-gamer .option-preview,
.preview-username.font-gamer {
  font-family:monospace;
  font-weight:900;
}

.font-champion .option-preview,
.preview-username.font-champion {
  font-weight:950;
  letter-spacing:1.5px;
}

.font-legend .option-preview,
.preview-username.font-legend {
  font-family:Georgia,serif;
  font-weight:950;
}

.font-future .option-preview,
.preview-username.font-future {
  letter-spacing:2px;
  text-transform:uppercase;
}

.font-matrix .option-preview,
.preview-username.font-matrix {
  font-family:monospace;
  letter-spacing:2px;
}

.font-pixel .option-preview,
.preview-username.font-pixel {
  font-family:monospace;
  letter-spacing:-1px;
}

.effect-fire .option-preview,
.effect-fire .preview-username {
  color:#ffb36b;
  text-shadow:0 0 8px #ff6a00,0 0 22px #ff2b00;
}

.effect-ice .option-preview,
.effect-ice .preview-username {
  color:#c9f5ff;
  text-shadow:0 0 8px #52ddff,0 0 22px #168dff;
}

.effect-electric .option-preview,
.effect-electric .preview-username {
  color:#f5fbff;
  text-shadow:0 0 7px #fff,0 0 22px #5db7ff;
}

.effect-inferno .option-preview,
.effect-inferno .preview-username {
  color:#ffd19a;
  text-shadow:0 0 10px #ff3c00,0 0 28px #ff0000;
}

.effect-frostbite .option-preview,
.effect-frostbite .preview-username {
  color:#e9ffff;
  text-shadow:0 0 8px #bfffff,0 0 24px #48cfff;
}

.effect-thunder .option-preview,
.effect-thunder .preview-username {
  color:#fff;
  text-shadow:0 0 8px #fff,0 0 25px #7a75ff;
}

.effect-neon .option-preview,
.effect-neon .preview-username {
  color:#fff;
  text-shadow:0 0 8px #fff,0 0 20px #ff4dff;
}

.effect-galaxy .option-preview,
.effect-galaxy .preview-username {
  color:#eee;
  text-shadow:0 0 8px #fff,0 0 25px #8d6bff;
}

.effect-shadow .option-preview,
.effect-shadow .preview-username {
  color:#aaa;
  text-shadow:0 0 12px #000;
}

.effect-none .option-preview {
  color:#fff;
}

.frame-preview {
  border:2px solid #444;
}

.frame-metallic .option-preview,
.frame-metallic.frame-preview {
  border:2px solid #b8b8bd;
  box-shadow:inset 0 0 0 1px #555,0 0 10px rgba(255,255,255,.18);
}

.frame-gold .option-preview,
.frame-gold.frame-preview {
  border:2px solid #d5ad55;
  box-shadow:0 0 14px rgba(255,200,70,.2);
}

.frame-diamond .option-preview,
.frame-diamond.frame-preview {
  border:2px solid #b9f8ff;
  box-shadow:0 0 16px rgba(100,230,255,.35);
}

.frame-neon .option-preview,
.frame-neon.frame-preview {
  border:2px solid #ff4dff;
  box-shadow:0 0 15px rgba(255,60,255,.4);
}

.frame-royal .option-preview,
.frame-royal.frame-preview {
  border:2px solid #a88cff;
}

.frame-titan .option-preview,
.frame-titan.frame-preview {
  border:3px solid #777;
}

.frame-champion .option-preview,
.frame-champion.frame-preview {
  border:2px solid #fff;
  box-shadow:0 0 15px rgba(255,255,255,.35);
}

.frame-inferno .option-preview,
.frame-inferno.frame-preview {
  border:2px solid #ff5a22;
  box-shadow:0 0 14px rgba(255,50,0,.4);
}

.frame-frost .option-preview,
.frame-frost.frame-preview {
  border:2px solid #72ddff;
  box-shadow:0 0 14px rgba(70,210,255,.4);
}

.background-preview {
  background:#08080a;
}

.bg-night .option-preview,
.preview-bg-night {
  background:radial-gradient(circle at 50% 20%,#20243b,#050508 65%);
}

.bg-carbon .option-preview,
.preview-bg-carbon {
  background:repeating-linear-gradient(45deg,#18181b 0 4px,#101012 4px 8px);
}

.bg-galaxy .option-preview,
.preview-bg-galaxy {
  background:radial-gradient(circle at 25% 25%,#754cff,transparent 10%),radial-gradient(circle at 70% 60%,#245cff,transparent 13%),#05030e;
}

.bg-arena .option-preview,
.preview-bg-arena {
  background:linear-gradient(135deg,#202020,#050505);
}

.bg-neon .option-preview,
.preview-bg-neon {
  background:linear-gradient(135deg,#16051d,#050b19);
}

.bg-cyber .option-preview,
.preview-bg-cyber {
  background:linear-gradient(135deg,#061b1d,#090913);
}

.bg-inferno .option-preview,
.preview-bg-inferno {
  background:radial-gradient(circle at 50% 100%,#8b2300,#080403 70%);
}

.bg-frost .option-preview,
.preview-bg-frost {
  background:radial-gradient(circle,#244e62,#05090c 70%);
}

.bg-storm .option-preview,
.preview-bg-storm {
  background:linear-gradient(135deg,#30343d,#07080b);
}

.bg-midnight .option-preview,
.preview-bg-midnight {
  background:linear-gradient(145deg,#15152b,#030306);
}

.bg-aurora .option-preview,
.preview-bg-aurora {
  background:linear-gradient(135deg,#071f20,#211044,#030406);
}

.bg-space .option-preview,
.preview-bg-space {
  background:radial-gradient(circle at 50% 20%,#38385b,#020206 70%);
}

.bg-volcano .option-preview,
.preview-bg-volcano {
  background:radial-gradient(circle at 50% 100%,#ff4d00,#100302 70%);
}

.bg-iceberg .option-preview,
.preview-bg-iceberg {
  background:linear-gradient(135deg,#0b3344,#05090c);
}

.bg-royal .option-preview,
.preview-bg-royal {
  background:linear-gradient(135deg,#29145d,#06030e);
}

.bg-gold .option-preview,
.preview-bg-gold {
  background:linear-gradient(135deg,#40351b,#090806);
}

.bg-red .option-preview,
.preview-bg-red {
  background:linear-gradient(135deg,#4c1010,#080303);
}

.bg-blue .option-preview,
.preview-bg-blue {
  background:linear-gradient(135deg,#0b2852,#03060c);
}

.bg-green .option-preview,
.preview-bg-green {
  background:linear-gradient(135deg,#0b3a28,#030806);
}

.builder-grid {
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(360px,.85fr);
  gap:28px;
}

.builder-fields {
  display:flex;
  flex-direction:column;
  gap:16px;
}

.builder-fields label {
  display:flex;
  flex-direction:column;
  gap:7px;
  color:#aaa;
  font-size:12px;
  font-weight:800;
}

.builder-fields input,
.builder-fields textarea {
  width:100%;
  box-sizing:border-box;
  border:1px solid #29292f;
  border-radius:10px;
  background:#09090c;
  color:#fff;
  padding:12px;
  outline:none;
}

.builder-fields input:focus,
.builder-fields textarea:focus {
  border-color:#777;
}

.two-columns {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
}

.intensity-control {
  margin-top:4px;
}

.range-heading {
  display:flex;
  justify-content:space-between;
}

.range-heading strong {
  color:#fff;
}

.intensity-control input {
  padding:0;
}

.switch-row {
  display:flex;
  gap:25px;
}

.switch-control {
  flex-direction:row !important;
  align-items:center;
}

.switch-control input {
  width:auto;
}

.form-actions {
  display:flex;
  justify-content:flex-end;
  gap:10px;
  margin-top:8px;
}

.clear-button,
.create-button,
.catalogue-actions button {
  border:1px solid #303036;
  border-radius:10px;
  padding:11px 18px;
  cursor:pointer;
  font-weight:900;
}

.clear-button {
  background:#151519;
  color:#aaa;
}

.create-button {
  background:#fff;
  color:#000;
}

.create-button:disabled {
  opacity:.5;
  cursor:not-allowed;
}

.preview-column {
  min-width:0;
}

.preview-heading {
  margin-bottom:12px;
}

.preview-heading span {
  display:block;
  font-size:11px;
  font-weight:950;
  letter-spacing:2px;
}

.preview-heading small {
  color:#777;
}

.market-preview {
  min-height:440px;
  position:relative;
  overflow:hidden;
  border-radius:20px;
  border:1px solid #35353b;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:30px;
  box-sizing:border-box;
  background-color:#060608;
}

.preview-grid {
  position:absolute;
  inset:0;
  opacity:.16;
  background-image:
    linear-gradient(#fff 1px,transparent 1px),
    linear-gradient(90deg,#fff 1px,transparent 1px);
  background-size:32px 32px;
}

.preview-noise {
  position:absolute;
  inset:0;
  opacity:.05;
  background-image:radial-gradient(#fff 1px,transparent 1px);
  background-size:5px 5px;
}

.preview-avatar-shell {
  position:relative;
  z-index:2;
  width:90px;
  height:90px;
  border-radius:50%;
  padding:5px;
  border:3px solid #555;
  background:#09090b;
}

.preview-avatar {
  width:100%;
  height:100%;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:linear-gradient(145deg,#27272c,#09090b);
  font-size:32px;
  font-weight:950;
}

.preview-username-wrap {
  position:relative;
  z-index:2;
  margin-top:20px;
  text-align:center;
}

.preview-username {
  position:relative;
  font-size:30px;
  font-weight:950;
}

.effect-aura {
  position:absolute;
  inset:-20px;
  filter:blur(18px);
  opacity:calc(var(--effect-intensity) * .6);
  pointer-events:none;
}

.effect-fire .effect-aura {
  background:radial-gradient(circle,#ff5a00,transparent 65%);
}

.effect-ice .effect-aura {
  background:radial-gradient(circle,#35dfff,transparent 65%);
}

.effect-electric .effect-aura {
  background:radial-gradient(circle,#fff,transparent 60%);
}

.effect-neon .effect-aura {
  background:radial-gradient(circle,#ff3cff,transparent 65%);
}

.effect-galaxy .effect-aura {
  background:radial-gradient(circle,#754cff,transparent 65%);
}

.effect-shadow .effect-aura {
  background:radial-gradient(circle,#000,transparent 65%);
}

.preview-badge-wrap {
  position:relative;
  z-index:3;
  display:flex;
  align-items:center;
  gap:10px;
  margin-top:20px;
}

.preview-badge-wrap strong {
  font-size:12px;
  letter-spacing:1px;
}

.market-badge {
  width:38px;
  height:38px;
  flex:none;
  display:grid;
  place-items:center;
  border-radius:50%;
  border:2px solid #777;
  background:#151519;
  color:#fff;
  font-weight:1000;
  font-size:17px;
  box-shadow:inset 0 0 8px rgba(255,255,255,.12),0 5px 18px rgba(0,0,0,.5);
}

.large-badge {
  width:58px;
  height:58px;
  font-size:27px;
  border-width:3px;
}

.badge-verified {
  background: #16c75a !important;
  background-image: linear-gradient(145deg, #65ff9b 0%, #16c75a 45%, #07913d 100%) !important;
  border: 3px solid #baffd1 !important;
  color: #ffffff !important;
  font-family: Arial, sans-serif !important;
  font-weight: 1000 !important;
  text-shadow: 0 1px 2px rgba(0, 70, 30, 0.8);
  box-shadow:
    inset 0 2px 5px rgba(255,255,255,.7),
    inset 0 -5px 8px rgba(0,70,30,.3),
    0 0 0 2px rgba(22,199,90,.3),
    0 0 22px rgba(22,199,90,.7) !important;
}

