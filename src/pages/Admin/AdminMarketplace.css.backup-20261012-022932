.badge-supreme,
.badge-ultimate {
  background:linear-gradient(145deg,#fff,#7560ff,#111);
  color:#fff;
}

.badge-veritas {
  background:linear-gradient(145deg,#fff,#333);
  color:#fff;
  border-color:#fff;
}

.badge-veritas-gold,
.badge-veritas-elite,
.badge-veritas-champion,
.badge-veritas-legend {
  background:linear-gradient(145deg,#fff1a3,#b3831c,#fff);
  color:#fff;
  border-color:#ffe070;
  box-shadow:0 0 18px rgba(255,215,80,.45);
}

.catalogue-header {
  padding:22px 24px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #25252a;
}

.catalogue-header span {
  font-size:10px;
  letter-spacing:2px;
  color:#777;
}

.catalogue-header h2 {
  margin:3px 0 0;
}

.catalogue-header > strong {
  color:#aaa;
}

.catalogue-list {
  display:flex;
  flex-direction:column;
}

.catalogue-item {
  display:grid;
  grid-template-columns:1fr auto auto;
  gap:20px;
  align-items:center;
  padding:16px 24px;
  border-bottom:1px solid #1f1f23;
}

.catalogue-item-main strong {
  display:block;
}

.catalogue-item-main span {
  color:#777;
  font-size:11px;
}

.catalogue-status {
  display:flex;
  gap:7px;
}

.status-active,
.status-paused,
.status-limited {
  padding:5px 8px;
  border-radius:7px;
  font-size:9px;
  font-weight:900;
  text-transform:uppercase;
}

.status-active {
  background:rgba(60,220,120,.12);
  color:#7ef0a5;
}

.status-paused {
  background:rgba(255,170,50,.12);
  color:#ffc36b;
}

.status-limited {
  background:rgba(160,100,255,.12);
  color:#c49bff;
}

.catalogue-actions {
  display:flex;
  gap:8px;
}

.catalogue-actions button {
  background:#17171b;
  color:#fff;
}

.catalogue-actions .delete-item {
  color:#ff8888;
}

.empty-catalogue {
  padding:40px;
  text-align:center;
  color:#777;
}

@media (max-width:1000px) {
  .visual-options {
    grid-template-columns:repeat(4,minmax(0,1fr));
  }

  .builder-grid {
    grid-template-columns:1fr;
  }
}

@media (max-width:700px) {
