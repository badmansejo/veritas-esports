  color:#fff;
}

.badge-royal {
  background:linear-gradient(145deg,#d5b8ff,#432276);
  color:#fff;
}

.badge-diamond {
  background:linear-gradient(145deg,#fff,#62e8ff);
  color:#176d85;
}

.badge-platinum {
  background:linear-gradient(145deg,#fff,#7d8794);
  color:#222;
}

.badge-gold {
  background:linear-gradient(145deg,#fff0a1,#c08a1e);
  color:#fff;
}

.badge-silver {
  background:linear-gradient(145deg,#fff,#777);
  color:#222;
}

.badge-champion {
