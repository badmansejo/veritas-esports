/* =========================================================
   CUSTOM BADGE DESIGNER
   ========================================================= */

.badge-designer {
  margin-top:30px;
  padding:22px;
  border:1px solid #29292f;
  border-radius:18px;
  background:
    radial-gradient(circle at 85% 10%,rgba(22,199,90,.08),transparent 35%),
    linear-gradient(145deg,#0d0d10,#151519);
}

.badge-designer-header {
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:20px;
  margin-bottom:22px;
}

.badge-designer-header h3 {
  margin:0 0 5px;
  font-size:18px;
  font-weight:950;
}

.badge-designer-header p {
  margin:0;
  color:#777;
  font-size:12px;
}

.badge-designer-layout {
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(300px,.8fr);
  gap:24px;
}

.badge-designer-controls {
  display:flex;
  flex-direction:column;
  gap:14px;
}

.badge-designer-controls label {
  display:flex;
  flex-direction:column;
  gap:7px;
  color:#aaa;
  font-size:11px;
  font-weight:900;
}

.badge-designer-controls input,
.badge-designer-controls select {
  width:100%;
  min-height:42px;
  box-sizing:border-box;
  border:1px solid #303037;
  border-radius:10px;
  background:#08080b;
  color:#fff;
  padding:10px 12px;
  outline:none;
}

.badge-designer-controls input:focus,
.badge-designer-controls select:focus {
  border-color:#16c75a;
  box-shadow:0 0 0 2px rgba(22,199,90,.12);
}

.badge-designer-controls input[type="color"] {
  height:44px;
  padding:4px;
  cursor:pointer;
}

.badge-designer-controls input[type="range"] {
  padding:0;
  accent-color:#16c75a;
}

.badge-designer-controls .two-columns {
  gap:12px;
}

.badge-designer-controls .switch-row {
  margin-top:2px;
}

.badge-designer-controls .create-button {
  margin-top:5px;
  width:100%;
  background:linear-gradient(135deg,#5cff9b,#16c75a);
  color:#03130a;
  border-color:#6cffaa;
  box-shadow:0 8px 25px rgba(22,199,90,.2);
}

.badge-designer-controls .create-button:hover {
  transform:translateY(-1px);
  box-shadow:0 10px 30px rgba(22,199,90,.3);
}

.badge-designer-preview {
  min-width:0;
}

.badge-designer-label {
  display:block;
  margin-bottom:10px;
  color:#777;
  font-size:10px;
  font-weight:950;
  letter-spacing:2px;
}

.badge-designer-preview > div {
  box-shadow:
    inset 0 0 50px rgba(0,0,0,.35),
    0 15px 45px rgba(0,0,0,.25);
}

.badge-designer-preview strong {
  text-shadow:0 2px 10px rgba(0,0,0,.7);
}

/* Custom badge selected state */
.badge-option.custom-selected {
  border-color:#16c75a;
  box-shadow:
    0 0 0 2px rgba(22,199,90,.15),
    0 8px 30px rgba(22,199,90,.12);
}

/* Better badge option previews */
.badge-option-preview {
  min-height:48px;
  display:grid;
  place-items:center;
}

.badge-option-preview .market-badge {
  transition:.18s ease;
}

.visual-option:hover .badge-option-preview .market-badge {
  transform:scale(1.08);
}

/* Green verified badge */
.badge-verified {
  background:#16c75a !important;
  background-image:
    linear-gradient(
      145deg,
      #78ffad 0%,
      #20d46c 35%,
      #0ca64b 70%,
      #067535 100%
    ) !important;
  border:3px solid #c4ffd8 !important;
  color:#fff !important;
  text-shadow:0 1px 2px rgba(0,60,25,.8);
  box-shadow:
    inset 0 2px 5px rgba(255,255,255,.75),
    inset 0 -5px 9px rgba(0,70,30,.35),
    0 0 0 2px rgba(22,199,90,.25),
    0 0 24px rgba(22,230,110,.7) !important;
}

.large-badge.badge-verified {
  width:62px;
  height:62px;
  font-size:30px;
  border-width:3px;
}

/* Responsive designer */
@media (max-width:900px) {
  .badge-designer-layout {
    grid-template-columns:1fr;
  }

  .badge-designer-preview {
    order:-1;
  }
}

@media (max-width:600px) {
  .badge-designer {
    padding:16px;
  }

  .badge-designer-header {
    flex-direction:column;
  }

  .badge-designer-header .clear-button {
    width:100%;
  }
}

