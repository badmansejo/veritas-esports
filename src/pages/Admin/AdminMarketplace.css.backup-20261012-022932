/* Animation keyframes */
@keyframes vFire {
  from { filter: brightness(1); transform: translateY(0); }
  to { filter: brightness(1.45); transform: translateY(-1px); }
}
@keyframes vSparks {
  0% { transform: translateY(8px); opacity: .2; }
  50% { opacity: .95; }
  100% { transform: translateY(-10px); opacity: .3; }
}
@keyframes vPhoenix {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.7); }
}
@keyframes vFlash {
  0%, 45%, 48%, 100% { opacity: 1; }
  46%, 47% { opacity: .45; }
}
@keyframes vPulse {
  0%, 100% { filter: brightness(.9); }
  50% { filter: brightness(1.6); }
}
@keyframes vDust {
  from { background-position: 0 0; opacity: .25; }
  to { background-position: 40px -60px; opacity: .8; }
}
@keyframes vShards {
  from { background-position: 0 -30px; opacity: .2; }
  to { background-position: 0 30px; opacity: .8; }
}
@keyframes vFrost {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.5); }
}
@keyframes vSolar {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.7) saturate(1.4); }
}
@keyframes vGlint {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.8); }
}
@keyframes vRainbow {
  from { background-position: 0% 50%; }
  to { background-position: 300% 50%; }
}
@keyframes vGlitch {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-1px); }
  75% { transform: translateX(1px); }
}
@keyframes vTitan {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.6); }
}
@keyframes vAura {
  from { opacity: .35; transform: scale(.94); }
  to { opacity: .85; transform: scale(1.08); }
}

