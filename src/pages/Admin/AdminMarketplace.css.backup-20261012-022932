.market-badge.badge-demon-horns { border-radius: 4px 18px 4px 18px !important; }
.market-badge.badge-warrior-shield { clip-path: polygon(0 0,100% 0,90% 72%,50% 100%,10% 72%); }
.market-badge.badge-blazing-star { border-radius: 50% !important; }
.market-badge.badge-crimson-wolf { border-radius: 18px 5px 18px 5px !important; }
.market-badge.badge-battle-axe { border-radius: 4px 18px !important; }
.market-badge.badge-red-lightning { background-size: 200% 200% !important; }
.market-badge.badge-ruby-diamond { border-radius: 5px !important; transform: rotate(45deg) scale(.85); }
.market-badge.badge-blood-moon { border-radius: 50% !important; background: radial-gradient(circle at 35% 30%, #ff8293, #b00022 60%, #35000a) !important; }
.market-badge.badge-fire-serpent { border-radius: 50% 8px !important; }
.market-badge.badge-champion-fist { border-radius: 12px !important; }
.market-badge.badge-war-eagle { border-radius: 50% 50% 8px 8px !important; }
.market-badge.badge-doom-emblem { border-radius: 4px !important; }
.market-badge.badge-red-vortex { border-radius: 50% 10% !important; }
.market-badge.badge-flame-heart { border-radius: 50% !important; }
.market-badge.badge-rage-mark { border-radius: 50% 5px !important; }
.market-badge.badge-elite-cross { border-radius: 8px !important; }
.market-badge.badge-ruby-wolf { border-radius: 50% 8px !important; }
.market-badge.badge-inferno-eye { border-radius: 50% !important; }
.market-badge.badge-skull-king { border-radius: 12px 12px 50% 50% !important; }
.market-badge.badge-red-comet { border-radius: 50% 8px 50% 8px !important; }
.market-badge.badge-crimson-claw { border-radius: 5px 18px !important; }
.market-badge.badge-war-crown { border-radius: 12px 12px 50% 50% !important; }
.market-badge.badge-phoenix-crest { border-radius: 50% 10% !important; }
.market-badge.badge-blood-knight { border-radius: 8px !important; }
