
import React, { useCallback, useEffect, useMemo, useState } from 'react'
import { useNavigate } from 'react-router-dom'
import { supabase } from '../../lib/supabase'

const initialForm = {
  name: '',
  game: 'Football',
  players: '8',
  format: 'Knockout',
  match_format: 'Bo1',
  match_rule: 'Golden Goal',
  management: 'Leader Managed',
  setup_mode: 'Automatic',
  start_time: '',
  rules: '',
  support_whatsapp: '',
  sponsor_name: '',
  sponsor_logo_url: '',
  sponsor_url: '',
  prize_pool: '',
  first_prize: '',
  second_prize: '',
  third_prize: '',
}

const games = ['Football', 'PUBG', 'COD', 'Mini Militia']

const styles = `
