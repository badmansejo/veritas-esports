function makeRoomCode() {
  return `VT${Math.random().toString(36).slice(2, 7).toUpperCase()}`
}

function money(value) {
  return `KES ${Number(value || 0).toLocaleString('en-KE')}`
}

function fontStyle(item) {
  const data = item?.preview_data || {}
  const css = data.css || data.style || {}
  const result = {}

  if (typeof css === 'object' && css) {
    if (css.fontFamily) result.fontFamily = css.fontFamily
    if (css.fontWeight) result.fontWeight = css.fontWeight
    if (css.fontStyle) result.fontStyle = css.fontStyle
    if (css.color) result.color = css.color
    if (css.textShadow) result.textShadow = css.textShadow
    if (css.letterSpacing) result.letterSpacing = css.letterSpacing
  }

  if (typeof data.fontFamily === 'string') result.fontFamily = data.fontFamily
  if (typeof data.color === 'string') result.color = data.color
  if (typeof data.textShadow === 'string') result.textShadow = data.textShadow

  return result
}

export default function Tournaments() {
  const navigate = useNavigate()
  const [user, setUser] = useState(null)
  const [profile, setProfile] = useState(null)
  const [tournaments, setTournaments] = useState([])
  const [creators, setCreators] = useState({})
  const [creatorFonts, setCreatorFonts] = useState({})
  const [counts, setCounts] = useState({})
  const [loading, setLoading] = useState(true)
  const [tab, setTab] = useState('all')
  const [search, setSearch] = useState('')
  const [showCreate, setShowCreate] = useState(false)
  const [showJoin, setShowJoin] = useState(false)
  const [form, setForm] = useState(initialForm)
  const [joinCode, setJoinCode] = useState('')
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState('')
  const [message, setMessage] = useState('')

  const isAdmin = Boolean(profile?.is_admin)

  const loadData = useCallback(async () => {
    setLoading(true)
    setError('')

    try {
      const { data: authData, error: authError } = await supabase.auth.getUser()
      if (authError) throw authError
      const currentUser = authData?.user

      if (!currentUser) {
        setUser(null)
        setProfile(null)
        setTournaments([])
        return
      }

      setUser(currentUser)

      const { data: profileData, error: profileError } = await supabase
        .from('profiles')
        .select('id, username, veritas_user_id, is_admin, kes_balance')
        .eq('id', currentUser.id)
        .maybeSingle()

      if (profileError) throw profileError
      setProfile(profileData || null)

      const { data: tournamentData, error: tournamentError } = await supabase
        .from('tournaments')
        .select('*')
        .order('created_at', { ascending: false })

      if (tournamentError) throw tournamentError

      const rows = tournamentData || []
      setTournaments(rows)

      const creatorIds = [...new Set([...rows.map((item) => item.creator_id), profileData?.id].filter(Boolean))]
      if (creatorIds.length) {
        const { data: profileRows, error: creatorError } = await supabase
          .from('profiles')
          .select('id, username, veritas_user_id')
          .in('id', creatorIds)

        if (!creatorError) {
          const map = {}
          ;(profileRows || []).forEach((row) => { map[row.id] = row })
          setCreators(map)
        }

        const { data: fontRows } = await supabase
          .from('equipped_items')
          .select('user_id, slot_type, item:marketplace_items(name, item_type, preview_data, slug)')
          .in('user_id', creatorIds)

        if (fontRows) {
          const fontMap = {}
          fontRows.forEach((row) => {
            const item = row.item
            const type = [
              row.slot_type,
              item?.item_type,
              item?.slug,
              item?.name
            ].filter(Boolean).join(' ').toLowerCase()

            if (
              type.includes('font') ||
              type.includes('username') ||
              type.includes('name style') ||
              type.includes('text style')
            ) {
              fontMap[row.user_id] = fontStyle(item)
            }
          })
          setCreatorFonts(fontMap)
        }
      } else {
        setCreators({})
        setCreatorFonts({})
      }

      const tournamentIds = rows.map((item) => item.id)
      if (tournamentIds.length) {
        const { data: participantRows } = await supabase
          .from('tournament_participants')
          .select('tournament_id')
          .in('tournament_id', tournamentIds)

        const countMap = {}
        ;(participantRows || []).forEach((row) => {
          countMap[row.tournament_id] = (countMap[row.tournament_id] || 0) + 1
        })
        setCounts(countMap)
      } else {
        setCounts({})
      }
    } catch (err) {
      setError(err?.message || 'Could not load tournaments.')
    } finally {
      setLoading(false)
    }
  }, [])

  useEffect(() => {
    loadData()
  }, [loadData])

  const visibleTournaments = useMemo(() => {
    const query = search.trim().toLowerCase()

    return tournaments.filter((item) => {
      const sponsored = Boolean(item.is_sponsored)
      if (tab === 'normal' && sponsored) return false
      if (tab === 'sponsored' && !sponsored) return false
      if (tab === 'open' && item.status !== 'Open') return false
      if (tab === 'active' && !['Live', 'Ongoing', 'In Progress'].includes(item.status)) return false
      if (tab === 'completed' && item.status !== 'Completed') return false

      if (query) {
        const creator = creators[item.creator_id]?.username || ''
        const haystack = `${item.name || ''} ${item.game || ''} ${item.format || ''} ${creator}`.toLowerCase()
        if (!haystack.includes(query)) return false
      }

      return true
    })
  }, [tournaments, tab, search, creators])

  function updateField(event) {
    const { name, value } = event.target
    setForm((current) => ({ ...current, [name]: value }))
  }

  async function createTournament(event) {
    event.preventDefault()
    setError('')
    setMessage('')

    if (!user || !profile) {
      setError('Your profile is not ready. Sign out and sign in again, then retry.')
      return
    }

    const sponsored = tab === 'create-sponsored'
    const name = form.name.trim()
    const rules = form.rules.trim()

    if (!name) return setError('Enter a tournament name.')
    if (Number(form.players) < 2 || Number(form.players) > 64) {
      return setError('Player limit must be between 2 and 64.')
    }
    if (rules.length > 200) return setError('Tournament rules must be 200 characters or fewer.')

    const prizePool = Number(form.prize_pool || 0)
    const first = Number(form.first_prize || 0)
    const second = Number(form.second_prize || 0)
    const third = Number(form.third_prize || 0)

    if (sponsored) {
      if (!form.sponsor_name.trim()) return setError('Enter the sponsor name.')
      if (!Number.isFinite(prizePool) || prizePool <= 0) return setError('Enter a valid sponsor prize pool.')
      if (first + second + third > prizePool) {
        return setError('The 1st, 2nd and 3rd prizes cannot exceed the total prize pool.')
      }
      if (!form.sponsor_logo_url.trim()) return setError('Add the sponsor image URL.')
    }

    setBusy(true)

    try {
      const payload = {
        creator_id: profile.id,
        tournament_code: makeRoomCode(),
        name,
        game: form.game,
        players: Number(form.players),
        format: form.format,
        match_format: form.match_format,
        match_rule: form.match_rule,
        management: form.management,
        entry_type: 'FREE',
        start_time: form.start_time || null,
        round_deadline: '22:00:00',
        rules: rules || null,
        status: 'Open',
        setup_mode: form.setup_mode,
        is_sponsored: sponsored,
        sponsor_name: sponsored ? form.sponsor_name.trim() : null,
        sponsor_logo_url: sponsored ? form.sponsor_logo_url.trim() : null,
        sponsor_url: sponsored ? (form.sponsor_url.trim() || null) : null,
        support_whatsapp: form.support_whatsapp.trim() || null,
        prize_pool: sponsored ? prizePool : 0,
        first_prize: sponsored ? first : 0,
        second_prize: sponsored ? second : 0,
        third_prize: sponsored ? third : 0,
        prize_pool_funded: false,
        creator_started: false,
        room_type: 'Public',
      }

      const { data, error: insertError } = await supabase
        .from('tournaments')
        .insert(payload)
        .select('*')
        .single()

      if (insertError) throw insertError

      setShowCreate(false)
      setForm(initialForm)
      setTab('all')
      setMessage(`Tournament created. Your room code is ${data.tournament_code}. Keep it private.`)
      await loadData()
      navigate(`/tournaments/${data.id}`)
    } catch (err) {
      setError(err?.message || 'Could not create tournament.')
    } finally {
      setBusy(false)
    }
  }

  async function joinTournament(event) {
    event.preventDefault()
    setError('')
    setMessage('')

    if (!profile) {
      setError('Your profile could not be found.')
      return
    }

    const code = joinCode.trim().toUpperCase()
    if (!code) return setError('Enter a tournament code.')

    setBusy(true)

    try {
      const { data: tournament, error: findError } = await supabase
        .from('tournaments')
        .select('id, name, status, players, is_sponsored')
        .eq('tournament_code', code)
        .maybeSingle()

      if (findError) throw findError
      if (!tournament) throw new Error('No tournament was found for that code.')
      if (tournament.status !== 'Open') throw new Error('This tournament is not open for joining.')

      const { count, error: countError } = await supabase
        .from('tournament_participants')
        .select('id', { count: 'exact', head: true })
        .eq('tournament_id', tournament.id)

      if (countError) throw countError
      if ((count || 0) >= tournament.players) throw new Error('This tournament is already full.')

      const { error: joinError } = await supabase
        .from('tournament_participants')
        .insert({
          tournament_id: tournament.id,
          user_id: profile.id,
        })

      if (joinError) {
        if (joinError.code === '23505') throw new Error('You have already joined this tournament.')
        throw joinError
      }

      setShowJoin(false)
      setJoinCode('')
      setMessage(`You joined ${tournament.name}.`)
      await loadData()
      navigate(`/tournaments/${tournament.id}`)
    } catch (err) {
      setError(err?.message || 'Could not join tournament.')
    } finally {
      setBusy(false)
    }
  }

  return (
    <div className="vt-page">
      <style>{styles}</style>
      <div className="vt-wrap">
        <section className="vt-hero">
          <div className="vt-kicker">VERITAS ESPORTS • COMPETE WITH HONOUR</div>
          <h1 className="vt-title">Tournament Arena</h1>
          <p className="vt-sub">
            Discover free gaming tournaments, create a room, join with a code,
            and follow sponsored competitions. Real-world football competitions
            will appear here as the football module is enabled.
          </p>
          <div className="vt-actions">
            <button className="vt-btn vt-btn-primary" onClick={() => { setError(''); setMessage(''); setTab('create-normal'); setShowCreate(true) }}>
              + Create Tournament
            </button>
            <button className="vt-btn" onClick={() => { setError(''); setMessage(''); setShowJoin(true) }}>
              Join with Code
            </button>
            <button className="vt-btn" onClick={loadData}>Refresh</button>
          </div>
        </section>

        {error && <div className="vt-error" role="alert">{error}</div>}
        {message && <div className="vt-success" role="status">{message}</div>}

        <div className="vt-card">
          <div className="vt-form-grid">
            <div className="vt-field">
              <label htmlFor="vt-search">Search tournaments</label>
              <div style={{display:'flex',alignItems:'center',gap:8,background:'#090e16',border:'1px solid #394251',borderRadius:9,padding:'0 12px'}}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" aria-hidden="true">
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-4-4" />
                </svg>
                <input
                  id="vt-search"
                  value={search}
                  onChange={(event) => setSearch(event.target.value)}
                  placeholder="Search by tournament, game or creator..."
                  style={{flex:1,minWidth:0,background:'transparent',border:0,outline:0,color:'#fff',padding:'12px 0'}}
                />
                {search && (
                  <button type="button" onClick={() => setSearch('')} aria-label="Clear search" style={{background:'transparent',border:0,color:'#d6b46c',cursor:'pointer',fontSize:18}}>×</button>
                )}
              </div>
            </div>
            <div className="vt-field">
              <label htmlFor="vt-sort">Your account</label>
              <input id="vt-sort" readOnly value={profile?.username ? `@${profile.username}` : 'Loading profile...'} style={creatorFonts[profile?.id] || {}} />
            </div>
          </div>
        </div>

        <nav className="vt-tabs" aria-label="Tournament filters">
          {[
            ['all', 'All'],
            ['normal', 'Normal'],
            ['sponsored', 'Sponsored'],
            ['open', 'Open'],
            ['active', 'Ongoing'],
            ['completed', 'Completed'],
          ].map(([value, label]) => (
            <button key={value} className={`vt-tab ${tab === value ? 'active' : ''}`} onClick={() => setTab(value)}>
              {label}
            </button>
          ))}
        </nav>

        <h2 className="vt-section-title">Available tournaments</h2>

        {loading ? (
          <div className="vt-loading">Loading tournaments...</div>
        ) : visibleTournaments.length === 0 ? (
          <div className="vt-empty">
            <h3>No tournaments found</h3>
            <p>Create a tournament or try another filter.</p>
          </div>
        ) : (
          <div className="vt-grid">
            {visibleTournaments.map((item) => {
              const creator = creators[item.creator_id]
              const mine = item.creator_id === profile?.id
              const sponsored = Boolean(item.is_sponsored)

              return (
                <article className="vt-card" key={item.id}>
                  <div>
                    <span className={`vt-tag ${sponsored ? 'gold' : ''}`}>
                      {sponsored ? 'SPONSORED' : 'NORMAL'}
                    </span>
                    <span className="vt-tag">{item.status}</span>
                    <span className="vt-tag">{item.game}</span>
                  </div>

                  <h3>{item.name}</h3>
                  <p className="vt-muted">
                    Created by{' '}
                    <strong style={creatorFonts[item.creator_id] || {}}>
                      {creator?.username ? `@${creator.username}` : 'VERITAS player'}
                    </strong>
                    {creator?.veritas_user_id ? ` · ID ${creator.veritas_user_id}` : ''}
                  </p>

                  {sponsored && (
                    <div className="vt-notice">
                      <strong>{item.sponsor_name || 'Tournament sponsor'}</strong>
                      <p className="vt-muted">Prize pool: {money(item.prize_pool)}</p>
                      {item.sponsor_logo_url && (
                        <img
                          src={item.sponsor_logo_url}
                          alt={`${item.sponsor_name || 'Sponsor'} logo`}
                          loading="lazy"
                          style={{ maxWidth: '100%', maxHeight: 90, objectFit: 'contain', marginTop: 8 }}
                          onError={(event) => { event.currentTarget.style.display = 'none' }}
                        />
                      )}
                    </div>
                  )}

                  <p className="vt-muted">
                    {item.format} · {item.match_format} · {item.match_rule}
                  </p>
                  <p className="vt-muted">
                    Players: {counts[item.id] || 0}/{item.players}
                    {item.start_time ? ` · Starts ${item.start_time}` : ''}
                  </p>

                  <div className="vt-card-foot">
                    <span className="vt-muted">{mine ? 'Creator access' : 'Participant view'}</span>
                    <button className="vt-btn vt-btn-primary" onClick={() => navigate(`/tournaments/${item.id}`)}>
                      View Tournament
                    </button>
                  </div>

                  {mine && (
                    <p className="vt-muted" style={{ marginTop: 10 }}>
                      Your room code: <strong>{item.tournament_code}</strong>
                    </p>
                  )}
                </article>
              )
            })}
          </div>
        )}

        <h2 className="vt-section-title">Tournament history</h2>
        <div className="vt-grid">
          {[
            ['Active', tournaments.filter((t) => ['Open', 'Live'].includes(t.status)).length],
            ['Ongoing', tournaments.filter((t) => ['Ongoing', 'In Progress'].includes(t.status)).length],
            ['Completed', tournaments.filter((t) => t.status === 'Completed').length],
          ].map(([label, total]) => (
            <div className="vt-card" key={label}>
              <div className="vt-muted">{label}</div>
              <div style={{ fontSize: 30, fontWeight: 900, marginTop: 6 }}>{total}</div>
              <div className="vt-muted">tournaments</div>
            </div>
          ))}
        </div>
      </div>

      {showCreate && (
        <div className="vt-modal-backdrop" onMouseDown={(event) => {
          if (event.target === event.currentTarget && !busy) setShowCreate(false)
        }}>
          <section className="vt-modal" role="dialog" aria-modal="true" aria-labelledby="vt-create-title">
            <div className="vt-modal-head">
              <h2 id="vt-create-title">Create tournament</h2>
              <button className="vt-close" onClick={() => setShowCreate(false)} aria-label="Close">×</button>
            </div>

            <div className="vt-tabs">
              <button className={`vt-tab ${tab !== 'create-sponsored' ? 'active' : ''}`} onClick={() => setTab('create-normal')}>
                Normal · Free
              </button>
              <button className={`vt-tab ${tab === 'create-sponsored' ? 'active' : ''}`} onClick={() => setTab('create-sponsored')}>
                Sponsored
              </button>
            </div>

            <form onSubmit={createTournament}>
              <div className="vt-form-grid">
                <div className="vt-field full">
                  <label htmlFor="vt-name">Tournament name *</label>
                  <input id="vt-name" name="name" value={form.name} onChange={updateField} maxLength={80} required placeholder="e.g. Friday Night Cup" />
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-game">Game *</label>
                  <select id="vt-game" name="game" value={form.game} onChange={updateField}>
                    {games.map((game) => <option key={game}>{game}</option>)}
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-players">Maximum players *</label>
                  <input id="vt-players" type="number" name="players" min="2" max="64" value={form.players} onChange={updateField} required />
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-format">Tournament format</label>
                  <select id="vt-format" name="format" value={form.format} onChange={updateField}>
                    <option>Knockout</option>
                    <option>League</option>
                    <option>Group + Knockout</option>
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-match-format">Match format</label>
                  <select id="vt-match-format" name="match_format" value={form.match_format} onChange={updateField}>
                    <option>Bo1</option>
                    <option>Bo3</option>
                    <option>Bo5</option>
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-rule">Match rule</label>
                  <select id="vt-rule" name="match_rule" value={form.match_rule} onChange={updateField}>
                    <option>Extra Time</option>
                    <option>Penalties</option>
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-management">Management</label>
                  <select id="vt-management" name="management" value={form.management} onChange={updateField}>
                    <option>Leader Managed</option>
                    <option>VERITAS Managed</option>
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-setup">Match setup mode</label>
                  <select id="vt-setup" name="setup_mode" value={form.setup_mode} onChange={updateField}>
                    <option>Automatic</option>
                    <option>Manual</option>
                    <option>Creator Assisted</option>
                  </select>
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-start">Start time</label>
                  <input id="vt-start" type="datetime-local" name="start_time" value={form.start_time} onChange={updateField} />
                </div>

                <div className="vt-field">
                  <label htmlFor="vt-whatsapp">Support WhatsApp number</label>
                  <input id="vt-whatsapp" name="support_whatsapp" value={form.support_whatsapp} onChange={updateField} placeholder="e.g. 2547..." />
                </div>

                <div className="vt-field full">
                  <label htmlFor="vt-rules">Rules (maximum 200 characters)</label>
                  <textarea id="vt-rules" name="rules" value={form.rules} onChange={updateField} maxLength={200} placeholder="Enter the tournament rules..." />
                  <span className="vt-muted">{form.rules.length}/200 characters</span>
                </div>
              </div>

              {tab === 'create-sponsored' && (
                <>
                  <div className="vt-notice">
                    Sponsored tournament prize money must be funded and verified securely before the tournament is advertised as funded.
                    This form records the proposed prize pool; it does not deduct wallet funds yet.
                  </div>
                  <div className="vt-form-grid">
                    <div className="vt-field">
                      <label htmlFor="vt-sponsor">Sponsor/brand name *</label>
                      <input id="vt-sponsor" name="sponsor_name" value={form.sponsor_name} onChange={updateField} required />
                    </div>
                    <div className="vt-field">
                      <label htmlFor="vt-logo">Sponsor logo image URL *</label>
                      <input id="vt-logo" type="url" name="sponsor_logo_url" value={form.sponsor_logo_url} onChange={updateField} required placeholder="https://..." />
                    </div>
                    <div className="vt-field full">
                      <label htmlFor="vt-sponsor-url">Sponsor website/contact URL</label>
                      <input id="vt-sponsor-url" type="url" name="sponsor_url" value={form.sponsor_url} onChange={updateField} placeholder="https://..." />
                    </div>
                    <div className="vt-field">
                      <label htmlFor="vt-pool">Total prize pool (KES) *</label>
                      <input id="vt-pool" type="number" min="1" step="1" name="prize_pool" value={form.prize_pool} onChange={updateField} required />
                    </div>
                    <div className="vt-field">
                      <label htmlFor="vt-first">1st prize (KES)</label>
                      <input id="vt-first" type="number" min="0" step="1" name="first_prize" value={form.first_prize} onChange={updateField} />
                    </div>
                    <div className="vt-field">
                      <label htmlFor="vt-second">2nd prize (KES)</label>
                      <input id="vt-second" type="number" min="0" step="1" name="second_prize" value={form.second_prize} onChange={updateField} />
                    </div>
                    <div className="vt-field">
                      <label htmlFor="vt-third">3rd prize (KES)</label>
                      <input id="vt-third" type="number" min="0" step="1" name="third_prize" value={form.third_prize} onChange={updateField} />
                    </div>
                  </div>
                  <p className="vt-muted">
                    Only upload permitted sponsor images. Nudity, NSFW content and prohibited material are not allowed.
                  </p>
                </>
              )}

              <div className="vt-actions">
                <button className="vt-btn vt-btn-primary" type="submit" disabled={busy}>
                  {busy ? 'Creating...' : 'Create tournament'}
                </button>
                <button className="vt-btn" type="button" disabled={busy} onClick={() => setShowCreate(false)}>
                  Cancel
                </button>
              </div>
            </form>
          </section>
        </div>
      )}

      {showJoin && (
        <div className="vt-modal-backdrop" onMouseDown={(event) => {
          if (event.target === event.currentTarget && !busy) setShowJoin(false)
        }}>
          <section className="vt-modal" role="dialog" aria-modal="true" aria-labelledby="vt-join-title">
            <div className="vt-modal-head">
              <h2 id="vt-join-title">Join tournament</h2>
              <button className="vt-close" onClick={() => setShowJoin(false)} aria-label="Close">×</button>
            </div>
            <p className="vt-muted">Enter the room code shared by the tournament creator.</p>
            <form onSubmit={joinTournament}>
              <div className="vt-field">
                <label htmlFor="vt-join-code">Tournament code</label>
                <input id="vt-join-code" value={joinCode} onChange={(event) => setJoinCode(event.target.value.toUpperCase())} maxLength={20} required placeholder="Enter code" />
              </div>
              <div className="vt-notice">
                By joining, you agree to follow the tournament rules. Rule violations or fraudulent match results may lead to account restrictions.
              </div>
              <div className="vt-actions">
                <button className="vt-btn vt-btn-primary" type="submit" disabled={busy}>
                  {busy ? 'Joining...' : 'Join tournament'}
                </button>
                <button className="vt-btn" type="button" disabled={busy} onClick={() => setShowJoin(false)}>Cancel</button>
              </div>
            </form>
          </section>
        </div>
      )}
    </div>
  )
}


