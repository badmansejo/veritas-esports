import React, { useCallback, useEffect, useState } from 'react';
import { supabase } from '../lib/supabase';

const unresolvedStatuses = [
  'pending',
  'disputed',
  'awaiting admin review',
];

const styles = {
  page: {
    minHeight: '100vh',
    background: '#080b12',
    color: '#f3f4f6',
    padding: '24px 16px',
    fontFamily: 'Arial, sans-serif',
  },
  container: { maxWidth: 1100, margin: '0 auto' },
  card: {
    background: '#111827',
    border: '1px solid #293244',
    borderRadius: 14,
    padding: 20,
    marginBottom: 16,
  },
  input: {
    width: '100%',
    boxSizing: 'border-box',
    padding: 12,
    marginTop: 8,
    color: '#fff',
    background: '#080b12',
    border: '1px solid #374151',
    borderRadius: 8,
  },
  button: {
    background: '#7c3aed',
    color: '#fff',
    border: 0,
    borderRadius: 8,
    padding: '12px 16px',
    fontWeight: 700,
    cursor: 'pointer',
  },
};

export default function AdminAgentAssignments() {
  const [isAdmin, setIsAdmin] = useState(false);
  const [loading, setLoading] = useState(true);
  const [busyId, setBusyId] = useState('');
  const [results, setResults] = useState([]);
  const [agents, setAgents] = useState([]);
  const [selections, setSelections] = useState({});
  const [error, setError] = useState('');
  const [message, setMessage] = useState('');

  const loadData = useCallback(async () => {
    setLoading(true);
    setError('');

    try {
      const { data: authData, error: authError } =
        await supabase.auth.getUser();

      if (authError) throw authError;

      const currentUser = authData?.user;

      if (!currentUser) {
        setIsAdmin(false);
        setResults([]);
        setAgents([]);
        setError('Sign in with your admin account.');
        return;
      }

      const { data: profile, error: profileError } = await supabase
        .from('profiles')
        .select('id, is_admin')
        .eq('id', currentUser.id)
        .single();

      if (profileError) throw profileError;

      if (profile?.is_admin !== true) {
        setIsAdmin(false);
        setResults([]);
        setAgents([]);
        setError('Access denied. This page is for admins only.');
        return;
      }

      setIsAdmin(true);

      const [
        { data: matchResults, error: resultsError },
        { data: agentProfiles, error: agentsError },
      ] = await Promise.all([
        supabase
          .from('match_results')
          .select('*')
          .not('admin_review_alerted_at', 'is', null)
          .in('result_status', [
            'Pending',
            'Disputed',
            'Awaiting Admin Review',
            'pending',
            'disputed',
            'awaiting admin review',
          ])
          .order('submitted_at', { ascending: true }),

        supabase
          .from('profiles')
          .select('id, username, veritas_user_id, account_status, is_admin')
          .eq('is_admin', false)
          .eq('account_status', 'active')
          .order('username', { ascending: true }),
      ]);

      if (resultsError) throw resultsError;
      if (agentsError) throw agentsError;

      const validResults = (matchResults || []).filter((result) =>
        unresolvedStatuses.includes(
          String(result.result_status || '').toLowerCase()
        )
      );

      const matchIds = [
        ...new Set(validResults.map((result) => result.match_id)),
      ];

      let matchMap = {};
      let tournamentMap = {};

      if (matchIds.length) {
        const { data: matches, error: matchesError } = await supabase
          .from('matches')
          .select('id, tournament_id, match_number, round_number, player_one_id, player_two_id')
          .in('id', matchIds);

        if (matchesError) throw matchesError;

        matchMap = Object.fromEntries(
          (matches || []).map((match) => [match.id, match])
        );

        const tournamentIds = [
          ...new Set(
            (matches || []).map((match) => match.tournament_id).filter(Boolean)
          ),
        ];

        if (tournamentIds.length) {
          const { data: tournaments, error: tournamentsError } =
            await supabase
              .from('tournaments')
              .select('id, name, game')
              .in('id', tournamentIds);

          if (tournamentsError) throw tournamentsError;

          tournamentMap = Object.fromEntries(
            (tournaments || []).map((tournament) => [
              tournament.id,
              tournament,
            ])
          );
        }
      }

      const agentMap = Object.fromEntries(
        (agentProfiles || []).map((agent) => [agent.id, agent])
      );

      setAgents(agentProfiles || []);

      setResults(
        validResults.map((result) => {
          const match = matchMap[result.match_id];

          return {
            ...result,
            match,
            tournament: match
              ? tournamentMap[match.tournament_id]
              : null,
            assignedAgent: result.assigned_agent_id
              ? agentMap[result.assigned_agent_id]
              : null,
          };
        })
      );
    } catch (err) {
      setError(err.message || 'Could not load agent assignments.');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadData();
  }, [loadData]);

  async function assignAgent(result) {
    const agentId = selections[result.id] || result.assigned_agent_id;

    if (!agentId) {
      setError('Select an agent first.');
      return;
    }

    if (!window.confirm('Assign this match review to the selected agent?')) {
      return;
    }

    setBusyId(result.id);
    setError('');
    setMessage('');

    try {
      const { error: rpcError } = await supabase.rpc(
        'veritas_assign_match_agent',
        {
          p_match_result_id: result.id,
          p_agent_id: agentId,
        }
      );

      if (rpcError) throw rpcError;

      setMessage('Agent assignment saved successfully.');
      await loadData();
    } catch (err) {
      setError(err.message || 'Could not assign the agent.');
    } finally {
      setBusyId('');
    }
  }

  return (
    <main style={styles.page}>
      <div style={styles.container}>
        <div style={{ color: '#a78bfa', fontWeight: 800, letterSpacing: 2 }}>
          VERITAS ESPORTS · ADMIN
        </div>

        <h1>Agent Assignment</h1>

        <p style={{ color: '#9ca3af' }}>
          Assign escalated match-result reviews to active, non-admin users.
        </p>

        <button
          type="button"
          style={{ ...styles.button, background: '#293244' }}
          onClick={loadData}
          disabled={loading}
        >
          {loading ? 'Loading...' : 'Refresh results'}
        </button>

        {error && (
          <div
            role="alert"
            style={{ ...styles.card, color: '#fca5a5', borderColor: '#b91c1c' }}
          >
            {error}
          </div>
        )}

        {message && (
          <div
            role="status"
            style={{ ...styles.card, color: '#6ee7b7', borderColor: '#047857' }}
          >
            {message}
          </div>
        )}

        {loading && <p>Loading escalated results...</p>}

        {!loading && isAdmin && (
          <p style={{ color: '#9ca3af' }}>
            Escalated unresolved results: <strong>{results.length}</strong>
            {' · '}
            Active agents available: <strong>{agents.length}</strong>
          </p>
        )}

        {!loading && isAdmin && agents.length === 0 && (
          <section style={styles.card}>
            No active non-admin users were found. An agent must have an
            active user account before they can be assigned.
          </section>
        )}

        {!loading && isAdmin && results.length === 0 && (
          <section style={styles.card}>
            <h3>No escalated results awaiting assignment</h3>
            <p style={{ color: '#9ca3af' }}>
              Results appear here after the system escalates them to admin
              review.
            </p>
          </section>
        )}

        {isAdmin && results.map((result) => {
          const selectedAgent =
            selections[result.id] || result.assigned_agent_id || '';

          return (
            <section key={result.id} style={styles.card}>
              <div
                style={{
                  display: 'flex',
                  justifyContent: 'space-between',
                  flexWrap: 'wrap',
                  gap: 12,
                }}
              >
                <div>
                  <h2 style={{ marginTop: 0 }}>
                    {result.tournament?.name || 'Tournament match'}
                  </h2>

                  <p style={{ color: '#9ca3af' }}>
                    {result.tournament?.game || 'Game not specified'}
                    {result.match?.round_number
                      ? ` · Round ${result.match.round_number}`
                      : ''}
                    {result.match?.match_number
                      ? ` · Match ${result.match.match_number}`
                      : ''}
                  </p>
                </div>

                <span
                  style={{
                    color: '#fbbf24',
                    background: '#422006',
                    padding: '7px 10px',
                    borderRadius: 20,
                    height: 'fit-content',
                  }}
                >
                  {result.result_status}
                </span>
              </div>

              <div
                style={{
                  padding: 14,
                  borderRadius: 10,
                  background: '#080b12',
                  marginBottom: 16,
                }}
              >
                <strong>Submitted score</strong>
                <div style={{ fontSize: 28, fontWeight: 800, marginTop: 8 }}>
                  {result.player_one_score} : {result.player_two_score}
                </div>

                <p style={{ color: '#9ca3af', fontSize: 13 }}>
                  Submitted:{' '}
                  {result.submitted_at
                    ? new Date(result.submitted_at).toLocaleString()
                    : 'Unknown'}
                </p>

                {result.dispute_reason && (
                  <p style={{ color: '#fbbf24' }}>
                    Review notes: {result.dispute_reason}
                  </p>
                )}
              </div>

              <label
                htmlFor={`agent-${result.id}`}
                style={{ fontWeight: 700 }}
              >
                Assign agent
              </label>

              <select
                id={`agent-${result.id}`}
                style={styles.input}
                value={selectedAgent}
                onChange={(event) =>
                  setSelections((previous) => ({
                    ...previous,
                    [result.id]: event.target.value,
                  }))
                }
                disabled={busyId === result.id || agents.length === 0}
              >
                <option value="">Choose an active user...</option>
                {agents.map((agent) => (
                  <option key={agent.id} value={agent.id}>
                    {agent.username || 'Unnamed user'}
                    {agent.veritas_user_id
                      ? ` · VERITAS ID ${agent.veritas_user_id}`
                      : ''}
                    {result.assigned_agent_id === agent.id
                      ? ' · Currently assigned'
                      : ''}
                  </option>
                ))}
              </select>

              {result.assignedAgent && (
                <p style={{ color: '#a78bfa' }}>
                  Currently assigned to: {result.assignedAgent.username}
                </p>
              )}

              <button
                type="button"
                style={{ ...styles.button, marginTop: 14 }}
                disabled={busyId === result.id || agents.length === 0}
                onClick={() => assignAgent(result)}
              >
                {busyId === result.id
                  ? 'Assigning...'
                  : result.assigned_agent_id
                    ? 'Reassign agent'
                    : 'Assign agent'}
              </button>
            </section>
          );
        })}
      </div>
    </main>
  );
}
