  background: rgba(80,50,5,.8);
  color: #ffd56a;
  font-size: 7px;
  font-weight: 1000;
  letter-spacing: .08em;
}

/* PREVIEW BASE */

.marketplace-live-preview {
  position: relative;
  min-height: 170px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  isolation: isolate;
  border-bottom: 1px solid #171d24;
  background: #080b0f;
}

.marketplace-live-preview::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(255,255,255,.055),
      transparent 58%
    );
  pointer-events: none;
}

.marketplace-username-preview {
  position: relative;
  z-index: 3;
  max-width: 88%;
  padding: 8px 12px;
  color: #fff;
  font-size: 19px;
  font-weight: 1000;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  transition: all .25s ease;
}

