/* =========================================================
   CUSTOM BADGES
   ========================================================= */

.marketplace-live-preview-badge {
  min-height: 170px;
}

.marketplace-badge-preview-wrap {
  position: relative;
  width: 145px;
  height: 145px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marketplace-custom-badge {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  font-size: 25px;
  font-weight: 1000;
  line-height: 1;
}

.marketplace-custom-badge span {
  position: relative;
  z-index: 3;
}

.badge-shape-circle {
  border-radius: 50%;
}

.badge-shape-rounded {
  border-radius: 18px;
}

.badge-shape-square {
  border-radius: 5px;
}

.badge-shape-shield {
  clip-path: polygon(
    50% 0%,
    92% 15%,
    88% 65%,
    50% 100%,
    12% 65%,
    8% 15%
  );
}

.badge-shape-hexagon {
  clip-path: polygon(
    25% 5%,
    75% 5%,
    100% 50%,
    75% 95%,
    25% 95%,
    0% 50%
  );
}

.badge-shape-diamond {
  clip-path: polygon(
    50% 0%,
    100% 50%,
    50% 100%,
    0% 50%
  );
}

.badge-shape-star {
  clip-path: polygon(
    50% 0%,
    61% 35%,
    98% 35%,
    68% 57%,
    79% 94%,
    50% 72%,
    21% 94%,
    32% 57%,
    2% 35%,
    39% 35%
  );
}

.badge-metallic::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      125deg,
      rgba(255,255,255,.5),
      transparent 25%,
      transparent 65%,
      rgba(255,255,255,.12)
    );
  pointer-events: none;
}

.marketplace-verified-label {
  position: absolute;
  right: 4px;
  bottom: 7px;
  z-index: 5;
  padding: 4px 7px;
  border: 1px solid rgba(186,255,209,.5);
  border-radius: 999px;
  background: #087b3d;
  color: #fff;
  font-size: 7px;
  font-weight: 1000;
  letter-spacing: .1em;
  box-shadow: 0 0 12px rgba(22,199,90,.45);
}

.marketplace-item-card:has(.marketplace-verified-label) {
  border-color: rgba(22,199,90,.4);
  box-shadow:
    0 0 28px rgba(22,199,90,.08);
}

