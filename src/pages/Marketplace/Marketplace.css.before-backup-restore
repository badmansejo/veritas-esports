  box-shadow:
    0 16px 40px rgba(0,0,0,.3),
    0 0 25px rgba(22,199,90,.05);
}

.marketplace-item-content {
  position: relative;
  padding: 14px;
}

.marketplace-item-content h3 {
  margin: 4px 0 6px;
  color: #fff;
