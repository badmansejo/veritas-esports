.marketplace-effect-ice {
  color: #c9f6ff;
  text-shadow:
    0 0 6px #5de7ff,
    0 0 18px #178cff;
}

.marketplace-effect-electric {
  color: #f2ff64;
  text-shadow:
    0 0 5px #dfff00,
    0 0 17px #75ff00;
}

.marketplace-effect-inferno {
  color: #ff792f;
  text-shadow:
    0 0 7px #ff2d00,
    0 0 24px #ff0000;
}

.marketplace-effect-frostbite {
  color: #e6fbff;
  text-shadow:
    0 0 8px #6eeaff,
    0 0 24px #008dff;
}

.marketplace-effect-thunder {
  color: #f5ff4e;
  text-shadow:
    0 0 8px #f5ff00,
    0 0 25px #8cff00;
