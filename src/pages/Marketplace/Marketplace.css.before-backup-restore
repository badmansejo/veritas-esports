  font-weight: 1000;
  line-height: 1.2;
}

.marketplace-item-content p {
  margin: 0 0 12px;
  color: #687480;
  font-size: 10px;
  line-height: 1.45;
}

.marketplace-item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.marketplace-item-bottom strong {
  color: #16c75a;
  font-size: 11px;
  font-weight: 1000;
}

.marketplace-item-bottom button {
  padding: 7px 11px;
  border: 1px solid #273039;
  border-radius: 8px;
  background: #10151a;
  color: #fff;
  cursor: pointer;
