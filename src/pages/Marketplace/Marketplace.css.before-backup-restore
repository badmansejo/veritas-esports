.marketplace-page {
  min-height: 100vh;
  padding: 28px;
  background:
    radial-gradient(circle at top right, rgba(0, 255, 140, 0.08), transparent 30%),
    radial-gradient(circle at bottom left, rgba(0, 140, 255, 0.07), transparent 30%),
    #05070a;
  color: #fff;
}

.marketplace-header {
  max-width: 1400px;
  margin: 0 auto 28px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.marketplace-header h1 {
  margin: 8px 0 4px;
  font-size: clamp(32px, 5vw, 54px);
  line-height: 1;
  font-weight: 1000;
  letter-spacing: -0.04em;
}

.marketplace-header p {
  margin: 0;
  color: #8e98a5;
  font-size: 14px;
  font-weight: 700;
}

.marketplace-back {
  border: 0;
  background: transparent;
  color: #16c75a;
  padding: 0;
  cursor: pointer;
  font-weight: 900;
  font-size: 13px;
}

.marketplace-vcoins-card {
  min-width: 155px;
  padding: 16px 20px;
  border: 1px solid rgba(22, 199, 90, 0.3);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      rgba(22, 199, 90, 0.16),
      rgba(8, 123, 61, 0.08)
    ),
    #0a0f0d;
  color: #fff;
  cursor: pointer;
  text-align: left;
  box-shadow: 0 0 28px rgba(22, 199, 90, 0.07);
}

.marketplace-vcoins-label {
  display: block;
  margin-bottom: 5px;
  color: #72e69a;
  font-size: 10px;
  font-weight: 1000;
  letter-spacing: 0.16em;
}

.marketplace-vcoins-card strong {
  font-size: 25px;
  font-weight: 1000;
}

.marketplace-vcoins-plus {
  float: right;
  margin-top: 3px;
  color: #16c75a;
  font-size: 25px;
  font-weight: 1000;
}

.marketplace-message {
  max-width: 1400px;
  margin: 0 auto 20px;
  padding: 13px 16px;
  border: 1px solid rgba(22, 199, 90, 0.25);
  border-radius: 12px;
  background: rgba(22, 199, 90, 0.08);
  color: #baffd1;
  font-size: 13px;
  font-weight: 800;
}

/* SECTIONS */

.marketplace-featured,
.marketplace-controls,
.marketplace-catalogue {
  max-width: 1400px;
  margin-left: auto;
  margin-right: auto;
}

.marketplace-featured {
  margin-bottom: 35px;
}

.marketplace-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 16px;
}

.marketplace-section-heading span {
  display: block;
  margin-bottom: 5px;
  color: #16c75a;
  font-size: 9px;
  font-weight: 1000;
  letter-spacing: 0.18em;
}

.marketplace-section-heading h2 {
  margin: 0;
  font-size: 25px;
  font-weight: 1000;
}

.marketplace-section-heading small {
  color: #697481;
  font-size: 11px;
  font-weight: 800;
}

/* FEATURED */

.marketplace-featured-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
}

.marketplace-featured-card {
  min-width: 0;
  padding: 0;
  border: 1px solid #171d24;
  border-radius: 18px;
  overflow: hidden;
  background: #0a0d11;
  color: #fff;
  text-align: left;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.marketplace-featured-card:hover {
  transform: translateY(-3px);
  border-color: rgba(22, 199, 90, 0.4);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);
}

.marketplace-featured-info {
  padding: 12px;
}

.marketplace-featured-info span {
  display: block;
  margin-bottom: 5px;
  color: #6f7b88;
  font-size: 8px;
  font-weight: 1000;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.marketplace-featured-info strong {
  display: block;
  overflow: hidden;
  color: #fff;
  font-size: 13px;
  font-weight: 1000;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.marketplace-featured-info small {
  display: block;
  margin-top: 6px;
  color: #16c75a;
  font-size: 10px;
  font-weight: 1000;
}

/* SEARCH + CATEGORIES */

.marketplace-controls {
  margin-bottom: 28px;
}

.marketplace-search {
  width: 100%;
  max-width: 600px;
  height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  padding: 0 15px;
  border: 1px solid #1a2129;
  border-radius: 14px;
  background: #0a0d11;
}

.marketplace-search span {
  color: #687582;
  font-size: 22px;
}

.marketplace-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}

.marketplace-search input::placeholder {
  color: #58636f;
}

.marketplace-category-bar {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.marketplace-category-bar button {
  padding: 10px 15px;
  border: 1px solid #1b222a;
  border-radius: 999px;
  background: #0b0f13;
  color: #7d8895;
  cursor: pointer;
  font-size: 11px;
  font-weight: 900;
  transition: all 0.2s ease;
}

.marketplace-category-bar button:hover {
  color: #fff;
  border-color: #2a333d;
}

.marketplace-category-bar button.active {
  border-color: #16c75a;
  background: #16c75a;
  color: #031008;
  box-shadow: 0 0 18px rgba(22, 199, 90, 0.18);
}

/* CATALOGUE */

.marketplace-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 16px;
}

.marketplace-empty {
  min-height: 180px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #202832;
  border-radius: 18px;
  color: #66727f;
  background: rgba(8, 11, 15, 0.7);
  font-size: 13px;
  font-weight: 800;
}

/* LIVE PREVIEW */

.marketplace-live-preview {
  position: relative;
  min-height: 170px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-bottom: 1px solid #171d24;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.05), transparent 60%),
    #080b0f;
}

.marketplace-live-preview::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.018) 25%,
      transparent 25%
    ),
    linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.018) 25%,
      transparent 25%
    );
  background-size: 18px 18px;
  opacity: 0.45;
  pointer-events: none;
}

.marketplace-username-preview {
  position: relative;
  z-index: 2;
  max-width: 90%;
  color: #fff;
  font-size: 18px;
  font-weight: 1000;
  letter-spacing: 0.02em;
  text-align: center;
  text-shadow: 0 2px 15px rgba(0, 0, 0, 0.8);
}

/* EFFECTS */

.preview-effect-fire,
.preview-effect-flame,
.preview-effect-inferno {
  color: #ffb000;
  text-shadow:
    0 0 6px #ff5a00,
    0 0 18px #ff2b00;
}

.preview-effect-ice,
.preview-effect-frost,
.preview-effect-frostbite {
  color: #bcecff;
  text-shadow:
    0 0 7px #56d9ff,
    0 0 20px #168fff;
}

.preview-effect-electric,
.preview-effect-lightning,
.preview-effect-thunder {
  color: #e9f46a;
  text-shadow:
    0 0 6px #d8ff00,
    0 0 18px #62ff00;
}

.preview-effect-neon {
  color: #ff54e8;
  text-shadow:
    0 0 7px #ff00d9,
    0 0 22px #7d00ff;
}

.preview-effect-galaxy,
.preview-effect-cosmic {
  color: #d6c6ff;
  text-shadow:
    0 0 8px #7b4dff,
    0 0 24px #e300ff;
}

.preview-effect-shadow,
.preview-effect-void {
  color: #aeb5bf;
  text-shadow: 0 0 14px #000;
}

.preview-effect-emerald {
  color: #54ffad;
  text-shadow: 0 0 18px #00c96a;
}

.preview-effect-ruby {
  color: #ff8a9e;
  text-shadow: 0 0 18px #ff1744;
}

.preview-effect-sapphire {
  color: #82b9ff;
  text-shadow: 0 0 18px #1768ff;
}

/* FONTS */

.preview-font-bold {
  font-weight: 1000;
}

.preview-font-elite,
.preview-font-champion,
.preview-font-legend,
.preview-font-supreme {
  font-weight: 1000;
  letter-spacing: 0.08em;
}

.preview-font-neon {
  font-weight: 900;
  letter-spacing: 0.08em;
  text-shadow: 0 0 12px currentColor;
}

.preview-font-royal {
  font-family: Georgia, serif;
  font-weight: 900;
  letter-spacing: 0.04em;
}

.preview-font-cyber,
.preview-font-digital,
.preview-font-tech {
  font-family: monospace;
  font-weight: 900;
  letter-spacing: 0.06em;
}

.preview-font-pixel,
.preview-font-arcade {
  font-family: monospace;
  font-weight: 1000;
  letter-spacing: 0.1em;
}

.preview-font-heavy,
.preview-font-ultra {
  font-weight: 1000;
  transform: scaleX(1.05);
}

.preview-font-veritas,
.preview-font-veritas-elite {
  font-weight: 1000;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* FRAMES */

.preview-frame-metallic,
.preview-frame-chrome,
.preview-frame-steel {
  padding: 10px 18px;
  border: 2px solid #8e9ba7;
  border-radius: 10px;
  box-shadow:
    inset 0 0 10px rgba(255, 255, 255, 0.08),
    0 0 14px rgba(255, 255, 255, 0.08);
}

.preview-frame-gold {
  padding: 10px 18px;
  border: 2px solid #d7ad38;
  border-radius: 10px;
  box-shadow: 0 0 18px rgba(215, 173, 56, 0.25);
}

.preview-frame-diamond,
.preview-frame-crystal {
  padding: 10px 18px;
  border: 2px solid #bcecff;
  border-radius: 10px;
  box-shadow: 0 0 20px rgba(86, 217, 255, 0.22);
}

.preview-frame-neon {
  padding: 10px 18px;
  border: 2px solid #ff38df;
  border-radius: 10px;
  box-shadow: 0 0 20px rgba(255, 0, 217, 0.25);
}

.preview-frame-veritas {
  padding: 10px 18px;
  border: 2px solid #16c75a;
  border-radius: 10px;
  box-shadow: 0 0 20px rgba(22, 199, 90, 0.25);
}

/* BACKGROUNDS */

.preview-background-night,
.preview-background-midnight,
.preview-background-shadow,
.preview-background-dark-arena {
  padding: 14px 22px;
  border-radius: 12px;
  background: #05070a;
}

.preview-background-galaxy,
.preview-background-space,
.preview-background-cosmic {
  padding: 14px 22px;
  border-radius: 12px;
  background:
    radial-gradient(circle at 20% 30%, #4b277c, transparent 30%),
    radial-gradient(circle at 80% 70%, #123c70, transparent 30%),
    #070812;
}

.preview-background-inferno,
.preview-background-volcano {
  padding: 14px 22px;
  border-radius: 12px;
  background:
    radial-gradient(circle, rgba(255, 70, 0, 0.25), transparent 60%),
    #120604;
}

.preview-background-frost,
.preview-background-iceberg {
  padding: 14px 22px;
  border-radius: 12px;
  background:
    radial-gradient(circle, rgba(80, 210, 255, 0.2), transparent 60%),
    #061017;
}

.preview-background-veritas-night {
  padding: 14px 22px;
  border-radius: 12px;
  background:
    radial-gradient(circle, rgba(22, 199, 90, 0.15), transparent 60%),
    #050a07;
}

/* BADGE PREVIEW */

.marketplace-live-preview-badge {
  min-height: 170px;
}

.marketplace-badge-preview-wrap {
  position: relative;
  z-index: 2;
  width: 145px;
  height: 145px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.marketplace-custom-badge {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

.marketplace-verified-label {
  position: absolute;
  right: 3px;
  bottom: 8px;
  z-index: 4;
  padding: 4px 7px;
  border: 1px solid rgba(186, 255, 209, 0.5);
  border-radius: 999px;
  background: #087b3d;
  color: #fff;
  font-size: 7px;
  font-weight: 1000;
  letter-spacing: 0.1em;
  box-shadow: 0 0 12px rgba(22, 199, 90, 0.45);
}

.marketplace-item-card:has(.marketplace-verified-label) {
  border-color: rgba(22, 199, 90, 0.35);
  box-shadow:
    0 14px 40px rgba(0, 0, 0, 0.18),
    0 0 28px rgba(22, 199, 90, 0.08);
}

.marketplace-item-card:has(.marketplace-verified-label)
  .marketplace-item-type {
  color: #16c75a;
}

/* MODAL */

.marketplace-modal-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(0, 0, 0, 0.78);
  backdrop-filter: blur(12px);
}

.marketplace-modal {
  position: relative;
  width: min(520px, 100%);
  max-height: 90vh;
  overflow: auto;
  border: 1px solid #222b34;
  border-radius: 24px;
  background: #090d12;
  box-shadow: 0 30px 100px rgba(0, 0, 0, 0.65);
}

.marketplace-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 10;
  width: 34px;
  height: 34px;
  border: 1px solid #29313a;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  cursor: pointer;
  font-size: 22px;
}

.marketplace-modal-preview {
  min-height: 220px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid #1b222a;
  background:
    radial-gradient(circle, rgba(22, 199, 90, 0.08), transparent 60%),
    #06090c;
}

.marketplace-modal-content {
  padding: 24px;
}

.marketplace-modal-content h2 {
  margin: 6px 0 8px;
  font-size: 28px;
  font-weight: 1000;
}

.marketplace-modal-content p {
  margin: 0 0 20px;
  color: #87929f;
  font-size: 13px;
  line-height: 1.6;
}

.marketplace-item-type {
  color: #778391;
  font-size: 9px;
  font-weight: 1000;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.marketplace-modal-price {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin: 20px 0 10px;
  padding: 14px;
  border: 1px solid #1b232b;
  border-radius: 13px;
  background: #0c1116;
}

.marketplace-modal-price span {
  color: #788490;
  font-size: 11px;
  font-weight: 800;
}

.marketplace-modal-price strong {
  color: #16c75a;
  font-size: 17px;
  font-weight: 1000;
}

.marketplace-modal-balance {
  margin-bottom: 16px;
  color: #788490;
  font-size: 11px;
  font-weight: 700;
}

.marketplace-modal-balance strong {
  color: #fff;
}

.marketplace-buy-button {
  width: 100%;
  min-height: 48px;
  border: 0;
  border-radius: 13px;
  background: #16c75a;
  color: #031008;
  cursor: pointer;
  font-size: 13px;
  font-weight: 1000;
  transition: all 0.2s ease;
}

.marketplace-buy-button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(22, 199, 90, 0.2);
}

.marketplace-buy-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* MOBILE */

@media (max-width: 1200px) {
  .marketplace-featured-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .marketplace-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .marketplace-page {
    padding: 20px;
  }

  .marketplace-header {
    align-items: flex-start;
  }

  .marketplace-featured-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .marketplace-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .marketplace-page {
    padding: 15px;
  }

  .marketplace-header {
    flex-direction: column;
    align-items: stretch;
  }

  .marketplace-vcoins-card {
    width: 100%;
  }

  .marketplace-featured-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .marketplace-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .marketplace-live-preview {
    min-height: 135px;
  }

  .marketplace-badge-preview-wrap {
    width: 110px;
    height: 110px;
  }

  .marketplace-verified-label {
    right: -2px;
    bottom: 1px;
  }

  .marketplace-modal-content {
    padding: 20px;
  }
}

@media (max-width: 430px) {
  .marketplace-featured-grid {
    grid-template-columns: 1fr;
  }

  .marketplace-grid {
    grid-template-columns: 1fr;
  }

  .marketplace-category-bar {
    gap: 6px;
  }

  .marketplace-category-bar button {
    padding: 9px 11px;
    font-size: 10px;
  }
}
