{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veritas-esportss",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
